{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(dd *)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/iTerm.app/Contents/Resources/utilities/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/iTerm.app/Contents/Resources/utilities/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/iTerm.app/Contents/Resources/utilities/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.content // \"\"' | { content=$(cat); lines=$(echo \"$content\" | wc -l | tr -d ' '); bytes=$(echo \"$content\" | wc -c | tr -d ' '); if [ \"$lines\" -gt 500 ] || [ \"$bytes\" -gt 51200 ]; then echo '{\"systemMessage\":\"⚠️ Large file detected ('\"$lines\"' lines, '\"$bytes\"' bytes). Consider using incremental writes: 1) Initial Write with skeleton, 2) Follow with Edit operations for content blocks.\",\"continue\":true}'; fi; } 2>/dev/null || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/iTerm.app/Contents/Resources/utilities/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/iTerm.app/Contents/Resources/utilities/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/iTerm.app/Contents/Resources/utilities/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/iTerm.app/Contents/Resources/utilities/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/iTerm.app/Contents/Resources/utilities/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/iTerm.app/Contents/Resources/utilities/cc-status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/MacBook/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "theme": "dark-daltonized",
  "mcpServers": {
    "code-review": {
      "args": [
        "/Users/MacBook/.claude/mcp/code-review/index.js"
      ],
      "command": "node"
    }
  },
  "userPromptSubmitHooks": [
    {
      "command": "/Users/MacBook/.claude/global_constraints_hook.sh"
    }
  ],
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
  }
}
