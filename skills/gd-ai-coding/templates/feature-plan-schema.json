{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-plan.json",
  "description": "功能拆分计划文件，由 feature-plan 子 skill 生成，定义所有待开发功能及其依赖关系",
  "oneOf": [
    {
      "type": "object",
      "description": "v1 格式（推荐）：包裹对象含 schema_version",
      "required": ["schema_version", "features"],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "features": {
          "$ref": "#/$defs/featureArray"
        }
      }
    },
    {
      "$ref": "#/$defs/featureArray",
      "description": "v0 格式（兼容）：纯数组"
    }
  ],
  "$defs": {
    "featureArray": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "type", "status", "dependencies", "proposal_scope", "related_requirements"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,40}$",
            "description": "功能唯一标识，必须与 specs/{capability} 目录名完全一致（如 user-auth、order-detail）"
          },
          "name": {
            "type": "string",
            "description": "功能名称（中文简述）"
          },
          "type": {
            "type": "string",
            "enum": ["page", "component", "service", "refactor"],
            "description": "功能类型：页面/组件/服务层/重构"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "done", "failed", "skipped"],
            "description": "执行状态"
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "依赖的 feature_id 列表（构成 DAG），引用其他 feature 的语义 slug"
          },
          "proposal_scope": {
            "type": "object",
            "properties": {
              "new_files": {
                "type": "array",
                "items": { "type": "string" },
                "description": "预计新增的文件路径"
              },
              "modified_files": {
                "type": "array",
                "items": { "type": "string" },
                "description": "预计修改的文件路径"
              },
              "proposal_section": {
                "type": "string",
                "description": "对应 proposal.md 中的章节标题"
              }
            },
            "required": ["new_files", "modified_files", "proposal_section"]
          },
          "related_requirements": {
            "type": "array",
            "items": { "type": "string" },
            "description": "关联的需求章节引用（如 §3.1, §4.2.1）"
          },
          "design_nodes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "关联的设计稿 DSL 节点名称（用于 codegen 阶段裁剪 ui_dsl.json，仅保留相关子树）。从 ui_tree.txt 中选取与当前功能直接相关的节点 name。page/component 类型必填（如有设计稿），service/refactor 类型留空。"
          },
          "current_step": {
            "type": ["string", "null"],
            "description": "当前执行步骤（feature-loop 运行时填充）"
          },
          "error_log": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": { "type": "string" },
                "error": { "type": "string" },
                "retry": { "type": "integer" },
                "resolved": { "type": "boolean" }
              }
            },
            "description": "运行时错误记录（feature-loop 自动填充）"
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "功能开始执行时间（ISO 8601）"
          },
          "updated_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "最近更新时间（ISO 8601）"
          },
          "assignee": {
            "type": "string",
            "description": "可选：多人协作模式下的指派人 git user.email。空串或缺省表示任何人可执行；非空时必须含 @（写入把关在 scripts/collab/assign.sh）"
          }
        }
      }
    }
  }
}
